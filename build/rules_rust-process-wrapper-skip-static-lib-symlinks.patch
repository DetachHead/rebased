+++ b/util/process_wrapper/main.rs
@@ -101,8 +101,10 @@
 
 /// Matching on what rustc can actually use within a given `-Ldependency=` directory
 #[cfg(any(windows, test))]
+// No `a`: `-L dependency=` only finds crates, and no crate is a `.a` file. `rules_rust` puts a `lib<name>.a` symlink
+// next to each rlib for `cc_common.link`, built while sibling actions scan the directory.
 const CRATE_SEARCH_ARTIFACT_EXTENSIONS: &[&str] =
-    &["rlib", "rmeta", "dll", "lib", "a", "so", "dylib"];
+    &["rlib", "rmeta", "dll", "lib", "so", "dylib"];
 
 #[cfg(any(windows, test))]
 fn is_crate_search_artifact(file_name: &str) -> bool {
