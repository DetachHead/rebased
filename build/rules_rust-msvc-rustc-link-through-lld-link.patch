+def _clang_cl_link_args_to_lld_link(args):
+    """The link arguments of a `clang-cl` link tool, in the form that `lld-link` takes.
 
+    `clang-cl` wraps each linker flag as `/clang:-Xlinker /clang:<flag>`, so keep `<flag>`. Keep the library search
+    paths and the input files too. Drop every other argument: it is a `clang-cl` driver flag, such as `/MT`.
+    """
+    lld_link_args = []
+    forward_next = False
+    for arg in args:
+        if forward_next:
+            lld_link_args.append(arg.removeprefix("/clang:"))
+            forward_next = False
+        elif arg in ("/clang:-Xlinker", "-Xlinker"):
+            forward_next = True
+        elif arg.upper().startswith(("/LIBPATH:", "-LIBPATH:")) or arg.lower().endswith((".lib", ".obj", ".res")):
+            lld_link_args.append(arg)
+    return lld_link_args
