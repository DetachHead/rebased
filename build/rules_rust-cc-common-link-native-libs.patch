+            "CoreFoundation",
+            "-framework",
+            "Security",
+            "-lutil",
+            "-liconv",
+        ]);
+        assert_eq!(
+            Link::parse(&args),
+            Link {
+                libraries: strings(&[
+                    "-lutil",
+                    "-framework",
+                    "Security",
+                    "-framework",
+                    "CoreFoundation",
+                    "-liconv"
+                ]),
+                library_files: Vec::new(),
+                allocator_shim: None,
+                object: Some("bazel-out/bin/printenv.printenv.0123456789abcdef-cgu.0.rcgu.o"),
+                output: Some("bazel-out/bin/printenv"),
+            }
