diff --git a/rust/private/native_libs_recorder/recorder.bzl b/rust/private/native_libs_recorder/recorder.bzl
new file mode 100644
--- /dev/null
+++ b/rust/private/native_libs_recorder/recorder.bzl
@@ -0,0 +1,48 @@
+"""The native libraries recorder, built without itself."""
+
+_RECORDER_SETTING = str(Label("//rust/settings:experimental_cc_common_link_native_libs_recorder"))
+
+_USE_CC_COMMON_LINK_SETTING = str(Label("//rust/settings:experimental_use_cc_common_link"))
+
+_USE_GLOBAL_ALLOCATOR_SETTING = str(Label("//rust/settings:experimental_use_global_allocator"))
+
+def _without_recorder_impl(_settings, _attr):
+    return {
+        _RECORDER_SETTING: str(Label("//rust/private/cc:empty")),
+        _USE_CC_COMMON_LINK_SETTING: False,
+        # The global allocator library needs `cc_common.link`, and the recorder has no `#[global_allocator]`.
+        _USE_GLOBAL_ALLOCATOR_SETTING: False,
+    }
+
+# Every Rust target depends on the recorder through the setting, so the recorder itself must not. Without the
+# recorder, a link through `cc_common.link` misses the `#[link]` libraries, so rustc links the recorder and its tools,
+# such as the process wrapper, itself.
+_without_recorder = transition(
+    implementation = _without_recorder_impl,
+    inputs = [],
+    outputs = [_RECORDER_SETTING, _USE_CC_COMMON_LINK_SETTING, _USE_GLOBAL_ALLOCATOR_SETTING],
+)
+
+def _native_libs_recorder_impl(ctx):
+    binary = ctx.executable.binary
+
+    # Bazel requires the executable of an `executable` rule to be generated by that rule, so it is symlinked.
+    executable = ctx.actions.declare_file("{}_/{}".format(ctx.label.name, binary.basename))
+    ctx.actions.symlink(output = executable, target_file = binary, is_executable = True)
+    return [DefaultInfo(files = depset([executable]), executable = executable)]
+
+native_libs_recorder = rule(
+    doc = "Builds the `rust_binary` of the recorder without the recorder and without `cc_common.link`.",
+    implementation = _native_libs_recorder_impl,
+    executable = True,
+    attrs = {
+        "binary": attr.label(
+            mandatory = True,
+            executable = True,
+            cfg = _without_recorder,
+        ),
+        "_allowlist_function_transition": attr.label(
+            default = "@bazel_tools//tools/allowlists/function_transition_allowlist",
+        ),
+    },
+)
