+
+    #[test]
+    fn reads_a_utf16_response_file() {
+        let text: Vec<u8> = [0xFF, 0xFE]
+            .into_iter()
+            .chain(
+                "\"/OUT:a b.exe\"\nole32.lib\n"
+                    .encode_utf16()
+                    .flat_map(u16::to_le_bytes),
+            )
+            .collect();
+        assert_eq!(
+            response_file_args(&decode(&text)).collect::<Vec<_>>(),
+            ["/OUT:a b.exe", "ole32.lib"]
+        );
+    }
+
+    #[test]
+    fn reads_a_utf8_response_file() {
+        let text = b"-o\nout\\\\dir/printenv\n-lutil\n";
+        assert_eq!(
+            response_file_args(&decode(text)).collect::<Vec<_>>(),
+            ["-o", "out\\dir/printenv", "-lutil"]
