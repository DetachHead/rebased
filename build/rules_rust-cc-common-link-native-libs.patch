@@ -0,0 +1,356 @@
+//! A linker for `rustc` that links nothing: it writes the native inputs of the link to a response file.
+//!
+//! Under `cc_common.link`, `rustc` only emits an object, so the libraries of each `#[link]` attribute never reach the
+//! linker. `rustc` reads them from the metadata of the crates, and it passes them only to the linker that it runs.
+//! Only that link also gets the allocator shim of `rustc`, which routes `__rust_alloc` to the `#[global_allocator]`
+//! of the crate graph or to the default allocator of `std`. So `rules_rust` also lets `rustc` link with this program,
+//! and passes the response file to `cc_common.link`.
+//!
+//! The arguments are those of a `link.exe` or of a `cc` link, maybe in `@` response files. The program writes each
+//! library that the link takes from a search path, one for each line, to the file that `RULES_RUST_NATIVE_LIBS`
+//! names. `rustc` writes the allocator shim in its output directory, and a `link.exe` link takes some libraries by
+//! path: an import library that `rustc` writes for a `raw-dylib` import in a temporary directory, or one that a build
+//! script finds. The program copies each of these files to the directory that `RULES_RUST_NATIVE_LIBS_FILES` names,
+//! which `cc_common.link` takes with the objects of the link. `rustc` may strip the link output after the link, so the program writes a copy of the first
+//! object there.
+
+use std::path::Path;
+use std::process::ExitCode;
+use std::{env, fs};
+
+/// The variable that names the response file to write.
+const OUTPUT_ENV_VAR: &str = "RULES_RUST_NATIVE_LIBS";
+
+/// The variable that names the directory for the files that the link takes by path.
+const FILES_ENV_VAR: &str = "RULES_RUST_NATIVE_LIBS_FILES";
+
+/// The cc toolchain links its own unwinder and compiler runtime, and `rustc` names the GCC ones.
+const TOOLCHAIN_LIBRARIES: &[&str] = &["gcc", "gcc_eh", "gcc_s", "unwind"];
+
+fn main() -> ExitCode {
+    match run() {
+        Ok(()) => ExitCode::SUCCESS,
+        Err(error) => {
+            eprintln!("ERROR: native_libs_recorder: {error}");
+            ExitCode::FAILURE
+        }
+    }
+}
+
+fn run() -> Result<(), String> {
+    let output =
+        env::var_os(OUTPUT_ENV_VAR).ok_or_else(|| format!("{OUTPUT_ENV_VAR} is not set"))?;
+    let args = expand_response_files(env::args().skip(1))?;
+    let link = Link::parse(&args);
+    let files: Vec<&str> = link
+        .allocator_shim
+        .iter()
+        .chain(&link.library_files)
+        .copied()
+        .collect();
+    match env::var_os(FILES_ENV_VAR) {
+        Some(directory) => copy_files(&files, Path::new(&directory))?,
+        None if !files.is_empty() => {
+            return Err(format!(
+                "the link takes files by path, but {FILES_ENV_VAR} is not set"
+            ))
+        }
+        None => {}
+    }
+    let response_file: String = link
+        .libraries
+        .iter()
+        .map(|library| format!("{library}\n"))
+        .collect();
+    fs::write(&output, response_file)
+        .map_err(|e| format!("cannot write {}: {e}", Path::new(&output).display()))?;
+    match (link.output, link.object) {
+        (Some(link_output), Some(object)) => copy(Path::new(object), Path::new(link_output)),
+        (Some(link_output), None) => {
+            fs::write(link_output, "").map_err(|e| format!("cannot write {link_output}: {e}"))
+        }
+        (None, _) => Ok(()),
+    }
+}
+
+/// Copies each file to `directory`, once for each file name.
+fn copy_files(files: &[&str], directory: &Path) -> Result<(), String> {
+    fs::create_dir_all(directory)
+        .map_err(|e| format!("cannot create {}: {e}", directory.display()))?;
+    let mut copies = Vec::new();
+    for file in files {
+        let file = Path::new(file);
+        let name = file
+            .file_name()
+            .ok_or_else(|| format!("{} has no file name", file.display()))?;
+        let copy_path = directory.join(name);
+        if !copies.contains(&copy_path) {
+            copy(file, &copy_path)?;
+            copies.push(copy_path);
+        }
+    }
+    Ok(())
+}
+
+fn copy(from: &Path, to: &Path) -> Result<(), String> {
+    fs::copy(from, to)
+        .map(|_| ())
+        .map_err(|e| format!("cannot copy {} to {}: {e}", from.display(), to.display()))
+}
+
+/// Replaces each `@<file>` argument with the arguments of that file.
+fn expand_response_files(args: impl IntoIterator<Item = String>) -> Result<Vec<String>, String> {
+    let mut expanded = Vec::new();
+    for arg in args {
+        match arg.strip_prefix('@') {
+            Some(file) => {
+                let bytes = fs::read(file).map_err(|e| format!("cannot read {file}: {e}"))?;
+                expanded.extend(response_file_args(&decode(&bytes)));
+            }
+            None => expanded.push(arg),
+        }
+    }
+    Ok(expanded)
+}
+
+/// `rustc` writes the response file of a `link.exe` link in UTF-16 with a byte order mark, and the others in UTF-8.
+fn decode(bytes: &[u8]) -> String {
+    match bytes {
+        [0xFF, 0xFE, rest @ ..] => {
+            let units: Vec<u16> = rest
+                .chunks_exact(2)
+                .map(|pair| u16::from_le_bytes([pair[0], pair[1]]))
+                .collect();
+            String::from_utf16_lossy(&units)
+        }
+        _ => String::from_utf8_lossy(bytes).into_owned(),
+    }
+}
+
+/// `rustc` writes one argument on each line, in quotes when the argument needs them.
+fn response_file_args(text: &str) -> impl Iterator<Item = String> + '_ {
+    text.lines()
+        .map(str::trim)
+        .filter(|line| !line.is_empty())
+        .map(|line| {
+            line.strip_prefix('"')
+                .and_then(|line| line.strip_suffix('"'))
+                .unwrap_or(line)
+        })
+        .map(|line| line.replace("\\\"", "\"").replace("\\\\", "\\"))
+}
+
+/// `rustc` names each object of a codegen unit `<crate>.<crate>.<hash>-cgu.<n>.rcgu.o`, and the allocator shim
+/// `<crate>.<hash>.rcgu.o`.
+fn is_allocator_shim(arg: &str) -> bool {
+    let name = arg.rsplit(['/', '\\']).next().unwrap_or(arg);
+    name.ends_with(".rcgu.o") && !name.contains("-cgu.")
+}
+
+#[derive(Debug, PartialEq)]
+struct Link<'a> {
+    /// The library arguments for the cc link tool, in the order of the link.
+    libraries: Vec<String>,
+    /// The libraries that a `link.exe` link takes by path.
+    library_files: Vec<&'a str>,
+    allocator_shim: Option<&'a str>,
+    /// The first object file of the link.
+    object: Option<&'a str>,
+    output: Option<&'a str>,
+}
+
+impl<'a> Link<'a> {
+    fn parse(args: &'a [String]) -> Self {
+        let objects = || {
+            args.iter()
+                .map(String::as_str)
+                .filter(|arg| arg.ends_with(".o") || arg.ends_with(".obj"))
+        };
+        let mut link = Link {
+            libraries: Vec::new(),
+            library_files: Vec::new(),
+            allocator_shim: objects().find(|arg| is_allocator_shim(arg)),
+            object: objects().next(),
+            output: None,
+        };
+        if args.iter().any(|arg| starts_with_ignore_case(arg, "/OUT:")) {
+            link.parse_msvc(args);
+        } else {
+            link.parse_cc(args);
+        }
+        link
+    }
+
+    /// A `link.exe` link names a library from a search path by its bare file name, such as `ole32.lib`, and other
+    /// libraries by path.
+    fn parse_msvc(&mut self, args: &'a [String]) {
+        for arg in args {
+            if starts_with_ignore_case(arg, "/OUT:") {
+                self.output = Some(&arg["/OUT:".len()..]);
+            } else if arg.to_ascii_lowercase().ends_with(".lib") && !is_msvc_option(arg) {
+                if arg.contains(['/', '\\']) {
+                    self.library_files.push(arg);
+                } else {
+                    self.add(&[arg]);
+                }
+            }
+        }
+    }
+
+    /// A `cc` link names a shared library as `-l<name>`, and a macOS framework as `-framework <name>`. A library
+    /// after `-Bstatic` is an archive, and `rustc` already bundles each archive into the `rlib` that needs it.
+    fn parse_cc(&mut self, args: &'a [String]) {
+        let mut is_static = false;
+        let mut args = args.iter();
+        while let Some(arg) = args.next() {
+            match arg.as_str() {
+                "-o" => self.output = args.next().map(String::as_str),
+                "-Wl,-Bstatic" | "-Bstatic" => is_static = true,
+                "-Wl,-Bdynamic" | "-Bdynamic" => is_static = false,
+                "-framework" | "-weak_framework" => {
+                    if let Some(framework) = args.next() {
+                        self.add(&[arg, framework]);
+                    }
+                }
+                _ => {
+                    let name = arg.strip_prefix("-l").unwrap_or_default();
+                    if !name.is_empty() && !is_static && !TOOLCHAIN_LIBRARIES.contains(&name) {
+                        self.add(&[arg]);
+                    }
+                }
+            }
+        }
+    }
+
+    /// Adds the arguments of one library, unless the link already names it.
+    fn add(&mut self, library: &[&String]) {
+        let is_known = self
+            .libraries
+            .windows(library.len())
+            .any(|known| known.iter().eq(library.iter().copied()));
+        if !is_known {
+            self.libraries
+                .extend(library.iter().map(|arg| arg.to_string()));
+        }
+    }
+}
+
+/// A `link.exe` option, such as `/IMPLIB:<path>`. A Unix path starts with `/` too, but a `/` follows its first name.
+fn is_msvc_option(arg: &str) -> bool {
+    let Some(option) = arg.strip_prefix(['/', '-']) else {
+        return false;
+    };
+    let name = option.split(':').next().unwrap_or_default();
+    !name.is_empty() && name.chars().all(|c| c.is_ascii_alphanumeric())
+}
+
+fn starts_with_ignore_case(arg: &str, prefix: &str) -> bool {
+    arg.get(..prefix.len())
+        .is_some_and(|start| start.eq_ignore_ascii_case(prefix))
+}
+
