+            "kernel32.lib",
+            "/LIBPATH:C:\\rust\\lib",
+            "ole32.lib",
+            "C:\\tmp\\rustcXYZ\\propsys.dll_imports.lib",
+            "/OUT:bazel-out/bin/printenv.exe",
+            "/IMPLIB:bazel-out/bin/printenv.dll.lib",
+            "/Users/me/out/m/lib/windows.0.52.0.lib",
+        ]);
+        assert_eq!(
+            Link::parse(&args),
+            Link {
+                libraries: strings(&["ole32.lib", "kernel32.lib"]),
+                library_files: vec![
+                    "C:\\tmp\\rustcXYZ\\propsys.dll_imports.lib",
+                    "/Users/me/out/m/lib/windows.0.52.0.lib"
+                ],
+                allocator_shim: Some("bazel-out/bin/printenv.atmb9y7hkwsnft6dfjydj9o2k.rcgu.o"),
+                object: Some("C:\\tmp\\rustcXYZ\\symbols.o"),
+                output: Some("bazel-out/bin/printenv.exe"),
+            }
+        );
+    }
+
+    #[test]
+    fn keeps_the_cc_shared_libraries_and_frameworks() {
+        let args = strings(&[
+            "-o",
+            "bazel-out/bin/printenv",
+            "bazel-out/bin/printenv.printenv.0123456789abcdef-cgu.0.rcgu.o",
+            "-Wl,-Bstatic",
+            "-lunwind",
+            "-lstatic_dep",
+            "-Wl,-Bdynamic",
+            "-lutil",
