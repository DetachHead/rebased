<idea-plugin visibility="public">
  <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
  <dependencies>
    <module name="intellij.libraries.jetbrains.annotations"/>
    <module name="intellij.libraries.kotlinx.coroutines.core"/>
    <module name="intellij.platform.core"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.frontend"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.problemView.security"/>
    <module name="intellij.platform.problemView.ui"/>
    <module name="intellij.platform.util.coroutines"/>
    <module name="intellij.platform.util.ui"/>
  </dependencies>
  <!-- endregion -->

  <extensionPoints>
    <extensionPoint qualifiedName="com.intellij.securityProblemsViewSubTab"
                    interface="com.intellij.platform.problemView.security.frontend.ProblemsViewSubTabProvider"
                    dynamic="true"/>
  </extensionPoints>

  <extensions defaultExtensionNs="com.intellij">
    <problemsViewPanelProvider implementation="com.intellij.platform.problemView.security.frontend.SecurityProblemsViewPanelProvider"/>
  </extensions>
</idea-plugin>
