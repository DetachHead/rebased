<idea-plugin>
  <name>Git Review Comments</name>
  <id>intellij.vcs.git.review.comments</id>
  <category>Version Controls</category>
  <vendor>JetBrains</vendor>
  <description><![CDATA[
    Adds a per-line gutter "add comment" affordance to Rebased's diff viewers and a
    <code>review</code> CLI command that opens a multi-file changeset review session.
    Comments collected during a review session can be exported to a JSON file via the
    "Finish Review" action, for consumption by external tooling (e.g. an AI coding
    assistant skill).
  ]]></description>

  <dependencies>
    <!-- region Generated dependencies - run `Generate Product Layouts` to regenerate -->
    <module name="intellij.platform.diff"/>
    <module name="intellij.platform.diff.impl"/>
    <module name="intellij.platform.collaborationTools"/>
    <module name="intellij.platform.vcs.impl"/>
    <module name="intellij.platform.util.diff"/>
    <module name="intellij.platform.ide.impl"/>
    <module name="intellij.platform.ide"/>
    <module name="intellij.platform.ide.core"/>
    <module name="intellij.platform.projectModel"/>
    <module name="intellij.platform.core.ui"/>
    <module name="intellij.platform.editor.ui"/>
    <module name="intellij.platform.util.ui"/>
    <!-- endregion -->
  </dependencies>

  <resource-bundle>messages.GitReviewCommentsBundle</resource-bundle>

  <extensions defaultExtensionNs="com.intellij">
    <diff.DiffExtension implementation="com.intellij.vcs.git.review.comments.ReviewDiffExtension"/>
    <appStarter id="review" implementation="com.intellij.vcs.git.review.comments.ReviewApplication"
                bundle="messages.GitReviewCommentsBundle" key="review.help"/>
  </extensions>

  <actions>
    <action id="Git.Review.FinishReview" class="com.intellij.vcs.git.review.comments.FinishReviewAction">
      <add-to-group group-id="Diff.ViewerToolbar" anchor="last"/>
    </action>
  </actions>
</idea-plugin>
